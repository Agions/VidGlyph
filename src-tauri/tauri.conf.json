{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidGlyph",
  "version": "0.1.0",
  "identifier": "com.agions.vidglyph.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "VidGlyph · 字映 — 视频字幕光学解析工坊",
        "width": 1400,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; connect-src 'self' ipc: tauri: https://github.com https://*.githubusercontent.com; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' blob:; media-src 'self' asset: blob: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "VidGlyph · 字映 - 专业视频字幕光学提取工坊",
    "longDescription": "VidGlyph · 字映 是一款本地优先的高性能视频硬字幕光学提取与精编工坊。基于 Rust 原生流式硬件解码直通 ONNX OCR，支持多轨时间轴、音频波形比对与 AI 智能润色审核。",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "asset-protocol": {
      "enable": true,
      "scope": []
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRjI4RkRFODNDOEYzRDMtYjFmOGFkNjE1ZmNkNDEyZA==",
      "endpoints": [
        "https://github.com/Agions/VidGlyph/releases/latest/download/latest.json"
      ]
    }
  }
}
